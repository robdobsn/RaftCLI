{
    "SysTypeName": "{{sys_type_name}}",
    "CmdsAtStart": "",
    "WebUI": "",
    "SysManager": {
        "monitorPeriodMs": 10000,
        "reportList": [
            "NetMan",
            "SysMan"
        ],
        "slowSysModMs": 50,
        "pauseWiFiforBLE": 1
    },
    {{{inc_bleman_in_systypes}}}
    {{{inc_netman_in_systypes}}}
    "ESPOTAUpdate": {
        "enable": {{{ota_enable}}},
        "OTADirect": 1
    },
    "LogManager": {
        "enable": 0,
        "logDests": [
            {
                "enable": false,
                "type": "RaftRemote",
                "port": 8080
            }
        ]
    },    
    "SerialConsole": {
        "enable": 1
    },
    {{{inc_webserver_in_systypes}}}
    "FileManager": {
        "enable": 1
    },
    "Publish": {
        "enable": 1
    },
    "DevMan": {
        "Buses": {
            "buslist":
            [
                {{{inc_i2c_in_devman}}}
            ]
        },        
        "Devices":
        [
        ]
    },
    "{{user_sys_mod_name}}": {
        "exampleGroup": {
            "exampleKey": "Welcome to Raft!"
        }
    }
}

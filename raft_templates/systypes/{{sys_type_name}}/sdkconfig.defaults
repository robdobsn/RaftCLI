# Define configuration
# Remove/repace these comments to set level to debug/info

# Default log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

{{{flash_size_4MB_sdkconfig}}}{{{flash_size_8MB_sdkconfig}}}{{{flash_size_16MB_sdkconfig}}}{{{flash_size_32MB_sdkconfig}}}

{{{console_uart_sdkconfig}}}{{{console_usb_jtag_sdkconfig}}}

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="build/raft/partitions.csv"
{{{inc_bleman_in_sdkconfig}}}

# Common ESP-related
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10000{{{main_task_core_sdkconfig}}}

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# mDNS
CONFIG_MDNS_PREDEF_NETIF_STA=y

# Build type
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Debug checks for thread-safety and memory corruption problems
# These cost code size and speed so are intended for development builds only
# To use them:
#   - comment out CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y above (the lwIP thread-safety
#     check is an assertion so it does nothing at all while assertions are disabled)
#   - uncomment the lines below
#   - consider also enabling RAFT_MAIN_TASK_CHECK_ABORT in systypes/Common/features.cmake
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
# CONFIG_LWIP_CHECK_THREAD_SAFETY=y
# CONFIG_HEAP_POISONING_COMPREHENSIVE=y
